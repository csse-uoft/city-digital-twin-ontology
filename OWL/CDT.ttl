@prefix : <http://ontology.eil.utoronto.ca/CDT#> .
@prefix WV: <http://www.wurvoc.org/vocabularies/WV/> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix ns: <http://creativecommons.org/ns#> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix bibo: <http://purl.org/ontology/bibo/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix om-1: <http://www.wurvoc.org/vocabularies/om-1.8/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix terms: <http://purl.org/dc/terms/> .
@prefix Change: <https://standards.iso.org/iso-iec/5087/-1/ed-1/en/ontology/Change/> .
@prefix CityUnits: <https://standards.iso.org/iso-iec/5087/-1/ed-1/en/ontology/CityUnits/> .
@prefix wgs84_pos: <http://www.w3.org/2003/01/geo/wgs84_pos#> .
@prefix RecurringEvent: <https://standards.iso.org/iso-iec/5087/-1/ed-1/en/ontology/RecurringEvent/> .
@prefix RecurringEvent1: <https://standards.iso.org/iso-iec/5087/-1/ed-1/en/ontology/RecurringEvent/#> .
@base <http://ontology.eil.utoronto.ca/CDT#> .

<http://ontology.eil.utoronto.ca/CDT/> rdf:type owl:Ontology ;
                                        owl:imports org: ,
                                                    <https://standards.iso.org/iso-iec/5087/-1/ed-1/en/ontology/GenericProperties/> ,
                                                    RecurringEvent: ,
                                                    <https://standards.iso.org/iso-iec/5087/-1/ed-1/en/ontology/SpatialLoc/> ,
                                                    <https://standards.iso.org/iso-iec/5087/-2/ed-1/en/ontology/Organization> ,
                                                    <https://standards.iso.org/iso-iec/5087/-2/ed-1/en/ontology/Code/> ;
                                        dc:description "An ontology for representing City Digital Twin data"@en ;
                                        dc:title "City Digital Twin Ontology"@en .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/elements/1.1/description
dc:description rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/title
dc:title rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.opengis.net/ont/geosparql#wktLiteral
<http://www.opengis.net/ont/geosparql#wktLiteral> rdf:type rdfs:Datatype .


###  http://www.w3.org/2001/XMLSchema#time
xsd:time rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://ontology.eil.utoronto.ca/CDT/providesService
:providesService rdf:type owl:ObjectProperty ;
                 rdfs:label "Provides service"@en .


###  http://www.w3c.org/ns/org#hasSite
<http://www.w3c.org/ns/org#hasSite> rdf:type owl:ObjectProperty ;
                                    rdfs:label "Has site"@en .


###  http://www.w3c.org/ns/org#hasUnit
<http://www.w3c.org/ns/org#hasUnit> rdf:type owl:ObjectProperty ;
                                    rdfs:label "Has unit"@en .


###  https://standards.iso.org/iso-iec/5087/-1/ed-1/en/ontology/RecurringEvent/hasDayOfWeek
RecurringEvent:hasDayOfWeek rdf:type owl:ObjectProperty ;
                            rdfs:label "Has day of week"@en .


###  https://standards.iso.org/iso-iec/5087/-1/ed-1/en/ontology/SpatialLoc/hasLocation
<https://standards.iso.org/iso-iec/5087/-1/ed-1/en/ontology/SpatialLoc/hasLocation> rdf:type owl:ObjectProperty ;
                                                                                    rdfs:label "Has location"@en .


