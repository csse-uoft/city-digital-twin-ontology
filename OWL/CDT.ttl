                 rdfs:label "Communal" .


###  http://ontology.eil.utoronto.ca/CDT/CompleteCommunityAmenity
:CompleteCommunityAmenity rdf:type owl:Class ;
                          rdfs:subClassOf :CDTOntologyThing ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty :providesService ;
                                            owl:someValuesFrom :Service
                                          ] ;
                          rdfs:label "Complete Community Amenity"@en .


###  http://ontology.eil.utoronto.ca/CDT/CulturalAmenity
:CulturalAmenity rdf:type owl:Class ;
