#################################################################
#    Classes
#################################################################

###  http://ontology.eil.utoronto.ca/5087/2/Contact//Address
<http://ontology.eil.utoronto.ca/5087/2/Contact//Address> rdf:type owl:Class ;
                                                          rdfs:label "Address"@en .


###  http://ontology.eil.utoronto.ca/5087/2/Contact//PhoneNumber
<http://ontology.eil.utoronto.ca/5087/2/Contact//PhoneNumber> rdf:type owl:Class ;
                                                              rdfs:label "Phone Number"@en .


###  http://ontology.eil.utoronto.ca/CDT/CDTForProfitOrganization
:CDTForProfitOrganization rdf:type owl:Class ;
                          rdfs:subClassOf :CDTOrganization ,
                                          <http://ontology.eil.utoronto.ca/CDT/https://standards.iso.org/iso-iec/5087/-2/ed-1/en/ontology/Organization/ForProfitOrganization> .


###  http://ontology.eil.utoronto.ca/CDT/CDTGovernmentOrganization
:CDTGovernmentOrganization rdf:type owl:Class ;
                           rdfs:subClassOf :CDTOrganization ,
                                           <https://standards.iso.org/iso-iec/5087/-2/ed-1/en/ontology/Organization/GovernmentOrganization> ;
                           rdfs:label "CDT Government Organization"@en .


###  http://ontology.eil.utoronto.ca/CDT/CDTNonProfitOrganization
:CDTNonProfitOrganization rdf:type owl:Class ;
                          rdfs:subClassOf :CDTOrganization ,
                                          <http://ontology.eil.utoronto.ca/CDT/https://standards.iso.org/iso-iec/5087/-2/ed-1/en/ontology/Organization/NonProfitOrganization> ;
                          rdfs:label "CDT Non Profit Organization"@en .


###  http://ontology.eil.utoronto.ca/CDT/CDTOntologyThing
:CDTOntologyThing rdf:type owl:Class .


###  http://ontology.eil.utoronto.ca/CDT/CDTOrganization
:CDTOrganization rdf:type owl:Class ;
                 rdfs:subClassOf <https://standards.iso.org/iso-iec/5087/-2/ed-1/en/ontology/Organization/Organization> ,
                                 [ rdf:type owl:Restriction ;
                                   owl:onProperty <http://www.w3c.org/ns/org#hasSite> ;
                                   owl:someValuesFrom :CDTSite
                                 ] ;
                 rdfs:label "CDT Organization"@en .


###  http://ontology.eil.utoronto.ca/CDT/CDTSite
:CDTSite rdf:type owl:Class ;
         rdfs:subClassOf org:Site ,
                         [ rdf:type owl:Restriction ;
                           owl:onProperty <https://standards.iso.org/iso-iec/5087/-1/ed-1/en/ontology/SpatialLoc/hasLocation> ;
                           owl:someValuesFrom <https://standards.iso.org/iso-iec/5087/-1/ed-1/en/ontology/SpatialLoc/Location>
                         ] ;
         rdfs:label "CDT Site"@en .


###  http://ontology.eil.utoronto.ca/CDT/ClinicAmenity
:ClinicAmenity rdf:type owl:Class ;
               rdfs:subClassOf :HealthAmenity ;
               rdfs:label "Clinic" .


###  http://ontology.eil.utoronto.ca/CDT/ClinicService
:ClinicService rdf:type owl:Class ;
               rdfs:subClassOf :Service ;
               rdfs:label "Clinic" .


###  http://ontology.eil.utoronto.ca/CDT/CollegeAmenity
:CollegeAmenity rdf:type owl:Class ;
                rdfs:subClassOf :SchoolAmenity ;
                rdfs:label "College" .


