                                                                                    rdfs:label "Operation"@en .


###  https://standards.iso.org/iso-iec/5087/-2/ed-1/en/ontology/Organization/Organization
<https://standards.iso.org/iso-iec/5087/-2/ed-1/en/ontology/Organization/Organization> rdf:type owl:Class ;
                                                                                       rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                                                                         owl:onProperty :providesService ;
                                                                                                         owl:someValuesFrom :Service
                                                                                                       ] ,
                                                                                                       [ rdf:type owl:Restriction ;
                                                                                                         owl:onProperty <http://www.w3c.org/ns/org#hasUnit> ;
                                                                                                         owl:someValuesFrom org:OrganizationalUnit
                                                                                                       ] ,
                                                                                                       [ rdf:type owl:Restriction ;
                                                                                                         owl:onProperty <https://standards.iso.org/iso-iec/5087/-2/ed-1/en/ontology/Contact/hasTelephone> ;
                                                                                                         owl:someValuesFrom <http://ontology.eil.utoronto.ca/5087/2/Contact//PhoneNumber>
                                                                                                       ] ,
