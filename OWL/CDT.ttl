<https://standards.iso.org/iso-iec/5087/-2/ed-1/en/ontology/Organization/IndustryType> rdf:type owl:Class ;
                                                                                       rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                                                                         owl:onProperty <https://standards.iso.org/iso-iec/5087/-2/ed-1/en/ontology/Code/hasCode> ;
                                                                                                         owl:someValuesFrom <https://standards.iso.org/iso-iec/5087/-2/ed-1/en/ontology/Code/Code>
